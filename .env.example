# Copy to .env and fill in. .env is gitignored.

# OpenAI — used by the LLM stages.
OPENAI_API_KEY=sk-...

# Optional: override default models.
# Stage 1 (cluster) is cheap and runs over many events. Stage 2 (narrate) is short and high-leverage.
BILLABLE_MODEL_CLUSTER=gpt-4o-mini
BILLABLE_MODEL_NARRATE=gpt-4o

# Path to your downloaded Google OAuth client JSON (Desktop application type).
# See README.md "Google OAuth (one-time)" for setup.
GOOGLE_OAUTH_CLIENT_SECRETS=./config/google_oauth_client.json

# Optional: override default cache, output, and notes directories.
BILLABLE_CACHE_DIR=./cache
BILLABLE_OUT_DIR=./out
BILLABLE_NOTES_PATH=./data/notes.jsonl

# ActivityWatch integration (optional — adapter no-ops if AW is not running).
# BILLABLE_AW_URL=http://localhost:5600
# BILLABLE_AW_MIN_FOCUS_MIN=2     # focus blocks shorter than this are dropped as noise

# Which capture sources to use by default. Override with --source flags on the
# CLI. Leave gdocs out until you've set up Google OAuth, otherwise you'll see
# a "Skipping gdocs" warning every run.
# BILLABLE_SOURCES=cursor,notes,activitywatch
